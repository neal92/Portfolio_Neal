# Variables d'environnement pour le portfolio
# Copiez ce fichier vers .env.local et configurez vos vraies valeurs

# Formspree Configuration
VITE_FORMSPREE_ID=your_formspree_id_here

# Outils de développement (désactiver en production)
VITE_DEV_TOOLS=false

# Configuration de sécurité
VITE_ENABLE_SENTRY=false
VITE_ENVIRONMENT=production

# API Keys (NE PAS committer les vraies valeurs)
# VITE_API_KEY=your_api_key_here
# VITE_ANALYTICS_ID=your_analytics_id_here

# Autres variables d'environnement
